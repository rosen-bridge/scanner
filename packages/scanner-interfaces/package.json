{
  "name": "@alakipalakikharaki/scanner-interfaces",
  "version": "0.4.0",
  "description": "Defines all scanner interfaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/scanner.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run build && npm publish --access public",
    "type-check": "tsc --noEmit",
    "publish:pkg": "npm publish --access public"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
