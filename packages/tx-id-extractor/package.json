{
  "name": "@rosen-bridge/tx-id-extractor",
  "version": "2.3.2",
  "description": "Extract and store all transaction ids in ogmios blocks.",
  "author": "Rosen Team",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "coverage": "jest --detectOpenHandles --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "release": "npm run test && npm run build && npm publish --access public",
    "test": "jest --detectOpenHandles",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cardano-ogmios/schema": "^6.6.1",
    "@rosen-bridge/abstract-extractor": "^2.0.3",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@rosen-bridge/extended-typeorm": "^0.2.1",
    "@rosen-bridge/scanner-interfaces": "^0.1.1",
    "sqlite3": "^5.1.7"
  },
  "type": "module",
  "devDependencies": {
    "@babel/preset-env": "^7.19.0",
    "@types/jest": "^28.1.6",
    "@types/json-bigint": "^1.0.1",
    "@types/node": "^22.18.0",
    "jest": "^28.1.3",
    "ts-jest": "^28.0.7",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
