{
  "name": "@rosen-bridge/bitcoin-runes-observation-extractor",
  "version": "0.3.1",
  "description": "Event observation data extractor for Bitcoin Runes chain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/scanner.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../../.gitignore",
    "release": "npm run test -- --run && npm run clean && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^3.0.1",
    "@rosen-bridge/abstract-observation-extractor": "^0.2.1",
    "@rosen-bridge/bitcoin-scanner": "^0.2.2",
    "@rosen-bridge/extended-typeorm": "^1.0.1",
    "@rosen-bridge/json-bigint": "^1.1.0",
    "@rosen-bridge/rosen-extractor": "^11.0.0",
    "@rosen-bridge/scanner-interfaces": "^0.2.1",
    "@rosen-bridge/tokens": "^4.0.1",
    "@rosen-clients/rate-limited-axios": "^1.1.0",
    "blakejs": "^1.2.1",
    "ordiscan": "^1.3.0"
  },
  "devDependencies": {
    "@rosen-bridge/abstract-scanner": "^0.2.2",
    "@vitest/coverage-istanbul": "^3.1.4",
    "tsx": "^4.19.4",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
