{
  "name": "@rosen-bridge/runes-observation-extractor",
  "version": "0.1.4",
  "description": "Event observation data extractor for Runes chain",
  "repository": "https://github.com/rosen-bridge/scanner",
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@rosen-bridge/abstract-scanner": "^0.1.0",
    "@types/node": "^20.11.9",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitest/coverage-istanbul": "^2.0.5",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@rosen-bridge/bitcoin-scanner": "^0.1.0",
    "@rosen-bridge/extended-typeorm": "^0.1.0",
    "@rosen-bridge/abstract-observation-extractor": "^7.1.4",
    "@rosen-bridge/rosen-extractor": "^8.0.1",
    "@rosen-bridge/scanner-interfaces": "^0.1.1",
    "@rosen-bridge/tokens": "^3.1.1",
    "axios": "1.9.0",
    "blakejs": "^1.2.1"
  }
}
