{
  "name": "@rosen-bridge/bitcoin-scanner",
  "version": "0.1.0",
  "description": "A Bitcoin blockchain scanner based on Esplora or Rpc Block Explorer API",
  "repository": "https://github.com/rosen-bridge/scanner",
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitest/coverage-istanbul": "^3.1.4",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@rosen-bridge/abstract-scanner": "^0.1.0",
    "@rosen-bridge/rate-limited-axios": "^0.2.1",
    "@rosen-bridge/scanner-interfaces": "^0.2.0"
  }
}
