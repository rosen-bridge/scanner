{
  "name": "@rosen-bridge/evm-scanner",
  "version": "0.1.0",
  "description": "An EVM chain scanner based on RPC.",
  "repository": "https://github.com/rosen-bridge/scanner",
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run build && npm publish --access public",
    "test": "NODE_OPTIONS=--loader=extensionless vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitest/coverage-istanbul": "^1.2.2",
    "extensionless": "^1.9.6",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "dependencies": {
    "@rosen-bridge/abstract-scanner": "^0.1.0",
    "@rosen-bridge/scanner-interfaces": "^0.1.1",
    "ethers": "6.13.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
