{
  "name": "@rosen-bridge/firo-scanner",
  "version": "0.1.0",
  "description": "A Firo blockchain scanner based on network RPC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/scanner.git"
  },
  "license": "MIT",
  "author": "AlefLm",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../../.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/abstract-scanner": "^1.0.2",
    "@rosen-bridge/scanner-interfaces": "^0.2.2",
    "@rosen-clients/rate-limited-axios": "^2.0.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
