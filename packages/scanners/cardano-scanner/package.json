{
  "name": "@rosen-bridge/cardano-scanner",
  "version": "8.0.0",
  "description": "A cardano chain scanner based on RPC.",
  "repository": "https://github.com/rosen-bridge/scanner",
  "license": "GPL-3.0",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS=--loader=extensionless vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.9",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitest/coverage-istanbul": "^3.1.4",
    "eslint": "^8.56.0",
    "extensionless": "^1.9.6",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vitest": "^3.1.4",
    "typeorm": "^0.3.20"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@rosen-bridge/scanner": "^8.0.0",
    "@rosen-bridge/scanner-interfaces": "^0.1.0",
    "@rosen-bridge/rate-limited-axios": "^0.2.1",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@blockfrost/blockfrost-js": "^6.0.0",
    "cockatiel": "^3.2.1",
    "@blockfrost/openapi": "0.1.78",
    "@emurgo/cardano-serialization-lib-nodejs": "^13.2.1",
    "@cardano-ogmios/client": "^6.6.1",
    "@cardano-ogmios/schema": "^6.6.1",
    "@rosen-bridge/json-bigint": "^0.1.0"
  }
}
