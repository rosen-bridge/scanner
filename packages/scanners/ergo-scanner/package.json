{
  "name": "@rosen-bridge/ergo-scanner",
  "version": "0.1.0",
  "description": "An Ergo chain scanner.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/scanner.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@rosen-bridge/abstract-scanner": "^0.1.0",
    "@rosen-bridge/scanner-interfaces": "^0.2.0",
    "@rosen-clients/ergo-explorer": "^2.0.0",
    "@rosen-clients/ergo-node": "^3.0.0"
  }
}
