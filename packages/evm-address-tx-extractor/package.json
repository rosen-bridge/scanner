{
  "name": "@rosen-bridge/evm-address-tx-extractor",
  "version": "1.1.4",
  "description": "Extract and store EVM chain notable data of transactions for an address",
  "repository": "",
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitest/coverage-istanbul": "^3.1.4",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@rosen-bridge/abstract-extractor": "^2.0.3",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@rosen-bridge/extended-typeorm": "^0.2.1",
    "@rosen-bridge/scanner-interfaces": "^0.1.1",
    "ethers": "6.13.2"
  }
}
