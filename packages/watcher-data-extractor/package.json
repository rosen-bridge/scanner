{
  "name": "@rosen-bridge/watcher-data-extractor",
  "version": "12.1.4",
  "description": "Extractor for rosen specific boxes on ergo blockchain",
  "author": "Rosen Team",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "build": "tsc --build",
    "type-check": "tsc --noEmit",
    "release": "npm run test && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "coverage": "npm run test -- --coverage"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@rosen-bridge/abstract-extractor": "^2.0.3",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@rosen-bridge/extended-typeorm": "^0.2.1",
    "@rosen-bridge/json-bigint": "^0.1.0",
    "@rosen-bridge/scanner-interfaces": "^0.1.1",
    "@rosen-bridge/tokens": "^3.1.1",
    "@rosen-clients/ergo-explorer": "^1.1.5",
    "@types/lodash-es": "^4.17.6",
    "blakejs": "^1.2.1",
    "ergo-lib-wasm-nodejs": "^0.24.1",
    "json-bigint": "^1.0.0",
    "lodash-es": "^4.17.21",
    "sqlite3": "^5.1.7"
  },
  "type": "module",
  "devDependencies": {
    "@rosen-bridge/abstract-scanner": "^0.1.0",
    "@types/json-bigint": "^1.0.1",
    "@types/node": "^22.18.0",
    "typescript": "^4.7.4",
    "@vitest/coverage-istanbul": "^3.1.4",
    "vitest": "^3.1.4",
    "tsx": "^4.19.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
