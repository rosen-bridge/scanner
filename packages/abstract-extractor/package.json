{
  "name": "@rosen-bridge/abstract-extractor",
  "version": "2.1.0",
  "description": "Rosen Bridge extractor interfaces to work with scanner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/scanner.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
