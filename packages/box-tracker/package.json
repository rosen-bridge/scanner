{
  "name": "@rosen-bridge/box-tracker",
  "version": "0.1.2",
  "description": "Tracking specific boxes where only one instance should exist at any time with the specified parameters.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/scanner.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "private": true,
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test -- --run && npm run clean && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/abstract-extractor": "^3.1.0",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/extended-typeorm": "^1.0.1",
    "@rosen-bridge/scanner-interfaces": "^0.2.2",
    "@rosen-bridge/tx-pot": "^2.0.3",
    "@rosen-clients/ergo-explorer": "^2.1.2",
    "@rosen-clients/ergo-node": "^3.1.2",
    "ergo-lib-wasm-nodejs": "^0.24.1"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
